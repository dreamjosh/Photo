<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Passport & Background Studio · JPG</title>
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" />
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Segoe UI', Roboto, system-ui, sans-serif;
        }
        body {
            background: linear-gradient(145deg, #f5f7fa 0%, #e9edf5 100%);
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 20px;
        }
        .card {
            max-width: 1000px;
            width: 100%;
            background: rgba(255, 255, 255, 0.7);
            backdrop-filter: blur(10px);
            -webkit-backdrop-filter: blur(10px);
            border-radius: 48px;
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25), inset 0 1px 2px rgba(255, 255, 255, 0.6);
            padding: 30px 30px 40px;
            border: 1px solid rgba(255, 255, 255, 0.5);
        }
        h1 {
            font-size: 2.2rem;
            font-weight: 600;
            letter-spacing: -0.5px;
            color: #1e293b;
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 8px;
        }
        h1 small {
            font-size: 1rem;
            font-weight: 400;
            color: #475569;
            margin-left: 8px;
            opacity: 0.8;
        }
        .subhead {
            color: #475569;
            margin-bottom: 28px;
            border-left: 4px solid #3b82f6;
            padding-left: 16px;
            font-weight: 400;
            background: rgba(59, 130, 246, 0.06);
            border-radius: 0 12px 12px 0;
            line-height: 1.5;
        }
        .grid-2 {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 28px;
        }
        @media (max-width: 700px) {
            .grid-2 {
                grid-template-columns: 1fr;
                gap: 30px;
            }
            .card { padding: 20px; }
            h1 { font-size: 1.8rem; }
        }
        .upload-area {
            background: rgba(255, 255, 255, 0.5);
            border-radius: 32px;
            padding: 20px;
            backdrop-filter: blur(4px);
            border: 1px dashed #94a3b8;
            transition: 0.2s;
            box-shadow: inset 0 2px 8px rgba(0,0,0,0.02);
        }
        .upload-area:hover {
            border-color: #3b82f6;
            background: rgba(255, 255, 255, 0.7);
        }
        .file-label {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 30px 10px;
            border-radius: 24px;
            background: rgba(241, 245, 249, 0.6);
            cursor: pointer;
            transition: 0.2s;
            gap: 10px;
            color: #1e293b;
        }
        .file-label i { font-size: 3.4rem; color: #3b82f6; opacity: 0.7; }
        .file-label span { font-weight: 500; font-size: 1.1rem; }
        .file-label small { color: #64748b; font-size: 0.85rem; }
        #fileInput { display: none; }
        .canvas-wrapper {
            background: white;
            border-radius: 24px;
            padding: 12px;
            box-shadow: 0 8px 20px rgba(0,0,0,0.05);
            margin-top: 16px;
            text-align: center;
        }
        #sourceCanvas {
            width: 100%;
            height: auto;
            max-height: 350px;
            object-fit: contain;
            border-radius: 16px;
            background: repeating-conic-gradient(#e2e8f0 0% 25%, white 0% 50%) 0 0 / 20px 20px;
            display: block;
        }
        .action-bar {
            display: flex;
            flex-wrap: wrap;
            gap: 12px;
            margin: 18px 0 8px;
            justify-content: center;
        }
        .btn {
            background: white;
            border: none;
            padding: 10px 20px;
            border-radius: 60px;
            font-weight: 500;
            display: inline-flex;
            align-items: center;
            gap: 10px;
            box-shadow: 0 4px 8px rgba(0,0,0,0.02);
            border: 1px solid #e2e8f0;
            transition: 0.15s;
            cursor: pointer;
            color: #1e293b;
            font-size: 0.95rem;
        }
        .btn-primary {
            background: #1e293b;
            border: 1px solid #1e293b;
            color: white;
            box-shadow: 0 8px 14px -6px rgba(30, 41, 59, 0.25);
        }
        .btn-primary i { color: white; }
        .btn-primary:hover { background: #0f172a; transform: scale(0.97); }
        .btn-outline {
            background: transparent;
            border: 1px solid #cbd5e1;
        }
        .btn-outline:hover { background: #f1f5f9; border-color: #94a3b8; }
        .btn-success {
            background: #0b3b2c;
            border-color: #0b3b2c;
            color: white;
        }
        .btn-success:hover { background: #064e3b; }
        .color-picker-row {
            display: flex;
            align-items: center;
            gap: 12px;
            flex-wrap: wrap;
            justify-content: center;
            margin: 8px 0;
        }
        .color-picker-row label {
            font-weight: 500;
            color: #334155;
            display: flex;
            align-items: center;
            gap: 8px;
        }
        #bgColorPicker {
            width: 44px;
            height: 44px;
            border: 2px solid #cbd5e1;
            border-radius: 60px;
            padding: 2px;
            background: white;
            cursor: pointer;
        }
        .passport-section {
            background: rgba(255, 255, 255, 0.5);
            border-radius: 32px;
            padding: 20px;
            backdrop-filter: blur(4px);
            border: 1px solid rgba(255, 255, 255, 0.6);
        }
        .passport-preview {
            background: white;
            border-radius: 24px;
            padding: 12px;
            box-shadow: 0 8px 20px rgba(0,0,0,0.05);
            text-align: center;
        }
        #outputCanvas {
            width: 100%;
            height: auto;
            max-height: 350px;
            object-fit: contain;
            border-radius: 16px;
            background: repeating-conic-gradient(#e2e8f0 0% 25%, white 0% 50%) 0 0 / 20px 20px;
            display: block;
        }
        .passport-actions {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: 12px;
            margin-top: 16px;
        }
        .badge {
            background: #dbeafe;
            color: #1e4b8a;
            padding: 4px 16px;
            border-radius: 40px;
            font-size: 0.8rem;
            font-weight: 600;
            letter-spacing: 0.3px;
        }
        .flex-center {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            flex-wrap: wrap;
        }
        .footer-note {
            margin-top: 20px;
            text-align: center;
            font-size: 0.8rem;
            color: #64748b;
            border-top: 1px solid #e2e8f0;
            padding-top: 18px;
        }
        .footer-note i { color: #3b82f6; }
        .download-btn {
            background: #1e293b;
            color: white;
            border: none;
            padding: 12px 28px;
            border-radius: 60px;
            font-weight: 600;
            display: inline-flex;
            align-items: center;
            gap: 12px;
            transition: 0.15s;
            cursor: pointer;
            box-shadow: 0 6px 14px rgba(0,0,0,0.08);
        }
        .download-btn i { color: white; }
        .download-btn:hover { background: #0f172a; transform: scale(0.96); }
        .dimension-hint {
            background: #f8fafc;
            border-radius: 40px;
            padding: 6px 18px;
            font-size: 0.8rem;
            color: #334155;
        }
        .jpg-badge {
            background: #facc15;
            color: #1e293b;
            padding: 2px 12px;
            border-radius: 30px;
            font-weight: 600;
            font-size: 0.75rem;
            letter-spacing: 0.3px;
        }
    </style>
</head>
<body>
<div class="card">
    <div class="flex-center" style="justify-content: space-between;">
        <h1>
            <i class="fas fa-id-card" style="color: #2563eb;"></i> Passport<span style="font-weight:300;">Studio</span>
            <small>BG remove · JPG export</small>
        </h1>
        <span class="badge"><i class="fas fa-magic"></i> AI-free · canvas</span>
    </div>
    <div class="subhead">
        <i class="fas fa-upload" style="margin-right: 10px; color: #3b82f6;"></i> 
        Upload photo → remove background → change color → <strong>download as JPG</strong> (passport 600x600)
        <span class="jpg-badge" style="margin-left: 12px;"><i class="fas fa-file-image"></i> .jpg</span>
    </div>

    <div class="grid-2">
        <!-- LEFT -->
        <div class="upload-area">
            <div class="file-label" id="fileLabel">
                <i class="fas fa-cloud-upload-alt"></i>
                <span>Choose photo</span>
                <small>JPG, PNG, WEBP</small>
            </div>
            <input type="file" id="fileInput" accept="image/*" />
            
            <div class="canvas-wrapper">
                <canvas id="sourceCanvas" width="400" height="400"></canvas>
            </div>
            
            <div class="action-bar">
                <button class="btn btn-primary" id="removeBgBtn"><i class="fas fa-eraser"></i> Remove BG</button>
                <button class="btn btn-outline" id="resetBtn"><i class="fas fa-undo-alt"></i> Reset</button>
            </div>

            <div class="color-picker-row">
                <label><i class="fas fa-palette"></i> BG color</label>
                <input type="color" id="bgColorPicker" value="#ffffff" />
                <button class="btn btn-outline" id="applyColorBtn" style="padding:6px 16px;"><i class="fas fa-check"></i> Apply</button>
                <span class="dimension-hint"><i class="far fa-image"></i> 600x600 px</span>
            </div>
            <div style="font-size:0.8rem; color:#475569; margin-top: 12px; text-align:center; background:#f1f5f9; border-radius:60px; padding:6px 12px;">
                <i class="fas fa-info-circle"></i> "Remove BG" → pick color → "Apply" → download JPG
            </div>
        </div>

        <!-- RIGHT -->
        <div class="passport-section">
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:12px;">
                <span style="font-weight:600; color:#0f172a;"><i class="fas fa-passport"></i> Passport size</span>
                <span class="badge" style="background:#e2e8f0; color:#1e293b;"><i class="fas fa-arrows-alt"></i> 2x2 inch / 600x600</span>
            </div>
            <div class="passport-preview">
                <canvas id="outputCanvas" width="600" height="600"></canvas>
            </div>
            <div class="passport-actions">
                <button class="download-btn" id="downloadJpgBtn"><i class="fas fa-download"></i> Download .jpg</button>
                <button class="btn btn-outline" id="cropPassportBtn"><i class="fas fa-crop-alt"></i> Crop to 600x600</button>
            </div>
            <div style="margin-top:14px; background:#f1f5f9; border-radius:30px; padding:6px 16px; font-size:0.8rem; color:#334155; display:flex; gap:10px; flex-wrap:wrap; justify-content:center;">
                <span><i class="fas fa-check-circle" style="color:#22c55e;"></i> Removed BG</span>
                <span><i class="fas fa-fill-drip"></i> Custom color</span>
                <span><i class="fas fa-arrows-alt-h"></i> 600x600</span>
                <span><i class="fas fa-file-image" style="color:#eab308;"></i> JPG export</span>
            </div>
        </div>
    </div>
    <div class="footer-note">
        <i class="fas fa-code"></i> Built with HTML5 Canvas · chroma-key background removal · JPG download
    </div>
</div>
<script>
    (function() {
        // DOM refs
        const fileInput = document.getElementById('fileInput');
        const sourceCanvas = document.getElementById('sourceCanvas');
        const outputCanvas = document.getElementById('outputCanvas');
        const ctxSrc = sourceCanvas.getContext('2d', { willReadFrequently: true });
        const ctxOut = outputCanvas.getContext('2d', { willReadFrequently: true });

        const removeBgBtn = document.getElementById('removeBgBtn');
        const resetBtn = document.getElementById('resetBtn');
        const applyColorBtn = document.getElementById('applyColorBtn');
        const bgColorPicker = document.getElementById('bgColorPicker');
        const downloadJpgBtn = document.getElementById('downloadJpgBtn');
        const cropPassportBtn = document.getElementById('cropPassportBtn');
        const fileLabel = document.getElementById('fileLabel');

        // state
        let originalImage = null;          // ImageData (original loaded)
        let currentProcessedData = null;   // ImageData after BG removal (with alpha)
        let currentBgColor = '#ffffff';
        let imageLoaded = false;

        const PASSPORT_SIZE = 600;

        // load image to canvas
        function loadImageToCanvas(img) {
            const srcW = img.width;
            const srcH = img.height;
            const maxDim = PASSPORT_SIZE;
            let drawW, drawH;
            if (srcW > srcH) {
                drawW = maxDim;
                drawH = (srcH / srcW) * maxDim;
            } else {
                drawH = maxDim;
                drawW = (srcW / srcH) * maxDim;
            }
            sourceCanvas.width = PASSPORT_SIZE;
            sourceCanvas.height = PASSPORT_SIZE;
            ctxSrc.clearRect(0, 0, PASSPORT_SIZE, PASSPORT_SIZE);
            ctxSrc.fillStyle = '#ffffff';
            ctxSrc.fillRect(0, 0, PASSPORT_SIZE, PASSPORT_SIZE);
            const offsetX = (PASSPORT_SIZE - drawW) / 2;
            const offsetY = (PASSPORT_SIZE - drawH) / 2;
            ctxSrc.drawImage(img, offsetX, offsetY, drawW, drawH);
            
            originalImage = ctxSrc.getImageData(0, 0, PASSPORT_SIZE, PASSPORT_SIZE);
            currentProcessedData = new ImageData(
                new Uint8ClampedArray(originalImage.data),
                PASSPORT_SIZE,
                PASSPORT_SIZE
            );
            updateOutputCanvas();
            imageLoaded = true;
        }

        function updateOutputCanvas() {
            if (!currentProcessedData) return;
            outputCanvas.width = PASSPORT_SIZE;
            outputCanvas.height = PASSPORT_SIZE;
            ctxOut.putImageData(currentProcessedData, 0, 0);
        }

        // chroma-key removal (green/blue)
        function removeBackground(data) {
            const imageData = new ImageData(
                new Uint8ClampedArray(data.data),
                data.width,
                data.height
            );
            const pixels = imageData.data;
            for (let i = 0; i < pixels.length; i += 4) {
                const r = pixels[i];
                const g = pixels[i+1];
                const b = pixels[i+2];
                const isGreen = (g > r && g > b && g > 80 && (g - r) > 20);
                const isBlue = (b > r && b > g && b > 80 && (b - r) > 20);
                if (isGreen || isBlue) {
                    pixels[i+3] = 0; // transparent
                }
            }
            return imageData;
        }

        // apply background color to transparent pixels
        function applyBgColor(data, hexColor) {
            const imageData = new ImageData(
                new Uint8ClampedArray(data.data),
                data.width,
                data.height
            );
            const pixels = imageData.data;
            let r=255, g=255, b=255;
            if (hexColor) {
                const hex = hexColor.replace('#', '');
                if (hex.length === 6) {
                    r = parseInt(hex.substring(0,2), 16);
                    g = parseInt(hex.substring(2,4), 16);
                    b = parseInt(hex.substring(4,6), 16);
                }
            }
            for (let i = 0; i < pixels.length; i += 4) {
                if (pixels[i+3] === 0) {
                    pixels[i] = r;
                    pixels[i+1] = g;
                    pixels[i+2] = b;
                    pixels[i+3] = 255;
                }
            }
            return imageData;
        }

        // reset
        function resetToOriginal() {
            if (!originalImage) return;
            currentProcessedData = new ImageData(
                new Uint8ClampedArray(originalImage.data),
                PASSPORT_SIZE,
                PASSPORT_SIZE
            );
            updateOutputCanvas();
            ctxSrc.putImageData(originalImage, 0, 0);
        }

        // handle file
        function handleFile(file) {
            if (!file) return;
            const reader = new FileReader();
            reader.onload = (e) => {
                const img = new Image();
                img.onload = () => {
                    loadImageToCanvas(img);
                    ctxSrc.putImageData(originalImage, 0, 0);
                };
                img.src = e.target.result;
            };
            reader.readAsDataURL(file);
        }

        // ----- EVENTS -----
        fileInput.addEventListener('change', (e) => {
            if (fileInput.files.length > 0) {
                handleFile(fileInput.files[0]);
                fileLabel.querySelector('span').innerText = fileInput.files[0].name;
            }
        });

        fileLabel.addEventListener('dragover', (e) => {
            e.preventDefault();
            fileLabel.style.background = '#dbeafe';
        });
        fileLabel.addEventListener('dragleave', () => {
            fileLabel.style.background = '';
        });
        fileLabel.addEventListener('drop', (e) => {
            e.preventDefault();
            fileLabel.style.background = '';
            if (e.dataTransfer.files.length > 0) {
                fileInput.files = e.dataTransfer.files;
                handleFile(e.dataTransfer.files[0]);
                fileLabel.querySelector('span').innerText = e.dataTransfer.files[0].name;
            }
        });

        removeBgBtn.addEventListener('click', () => {
            if (!currentProcessedData) return;
            const removed = removeBackground(currentProcessedData);
            currentProcessedData = removed;
            updateOutputCanvas();
            ctxSrc.putImageData(removed, 0, 0);
        });

        applyColorBtn.addEventListener('click', () => {
            if (!currentProcessedData) return;
            const hex = bgColorPicker.value;
            currentBgColor = hex;
            const colored = applyBgColor(currentProcessedData, hex);
            currentProcessedData = colored;
            updateOutputCanvas();
            ctxSrc.putImageData(colored, 0, 0);
        });

        resetBtn.addEventListener('click', resetToOriginal);

        cropPassportBtn.addEventListener('click', () => {
            if (!currentProcessedData) return;
            updateOutputCanvas();
        });

        // ----- DOWNLOAD AS JPG (quality 0.92) -----
        downloadJpgBtn.addEventListener('click', () => {
            if (!currentProcessedData) {
                alert('Please upload a photo first.');
                return;
            }
            // Ensure output canvas is up-to-date
            updateOutputCanvas();
            // Convert to JPG with white background if alpha exists (flatten)
            const tempCanvas = document.createElement('canvas');
            tempCanvas.width = PASSPORT_SIZE;
            tempCanvas.height = PASSPORT_SIZE;
            const tempCtx = tempCanvas.getContext('2d');
            // Fill white background (in case of transparent pixels)
            tempCtx.fillStyle = '#ffffff';
            tempCtx.fillRect(0, 0, PASSPORT_SIZE, PASSPORT_SIZE);
            // Draw output canvas content (which may have alpha)
            tempCtx.drawImage(outputCanvas, 0, 0);
            // Export as JPG
            const link = document.createElement('a');
            link.download = 'passport_photo.jpg';
            link.href = tempCanvas.toDataURL('image/jpeg', 0.92);
            link.click();
        });

        // init
        bgColorPicker.value = '#ffffff';

        // placeholder
        (function initPlaceholder() {
            sourceCanvas.width = PASSPORT_SIZE;
            sourceCanvas.height = PASSPORT_SIZE;
            ctxSrc.fillStyle = '#eef2f6';
            ctxSrc.fillRect(0, 0, PASSPORT_SIZE, PASSPORT_SIZE);
            ctxSrc.fillStyle = '#94a3b8';
            ctxSrc.font = '18px "Segoe UI"';
            ctxSrc.textAlign = 'center';
            ctxSrc.fillText('Upload your photo', 300, 280);
            ctxSrc.fillText('(JPG / PNG)', 300, 320);

            outputCanvas.width = PASSPORT_SIZE;
            outputCanvas.height = PASSPORT_SIZE;
            ctxOut.fillStyle = '#eef2f6';
            ctxOut.fillRect(0, 0, PASSPORT_SIZE, PASSPORT_SIZE);
            ctxOut.fillStyle = '#94a3b8';
            ctxOut.font = '18px "Segoe UI"';
            ctxOut.textAlign = 'center';
            ctxOut.fillText('Passport preview', 300, 280);
        })();
    })();
</script>
</body>
</html>
